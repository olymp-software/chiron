{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olymp-software/chiron/schemas/workshop/v1.json",
  "title": "Chiron workshop manifest (workshop.yaml), schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "sections"],
  "properties": {
    "version": {
      "description": "Schema version of this file.",
      "const": 1
    },
    "title": {
      "description": "Workshop title.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "Short plain-text summary, shown in the course overview when there is no OVERVIEW.md.",
      "type": "string"
    },
    "check": {
      "description": "Path from the workshop root to the environment check script.",
      "type": "string",
      "minLength": 1
    },
    "controls": {
      "description": "Buttons in the course overview that run scripts from the workshop root.",
      "type": "array",
      "items": { "$ref": "#/$defs/control" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "slug": {
      "description": "Lowercase letters and digits separated by single hyphens; equals the folder name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "script"],
      "properties": {
        "label": {
          "description": "Button text.",
          "type": "string",
          "minLength": 1
        },
        "script": {
          "description": "Path from the workshop root to the script the control runs.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "activities"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/activity" }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 }
      }
    }
  }
}
