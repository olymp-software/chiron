{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shikijs/themes": "^4.5.0",
    "markdown-it": "^15.0.3",
    "shiki": "^4.5.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@babel/types": "^7.26.0",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.1.0"
  }
}
